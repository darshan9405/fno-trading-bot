# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me

# --- Database ---
# Local dev: sqlite:///./fno.db  (docker-compose overrides to sqlite:////data/fno.db on a volume)
DATABASE_URL=sqlite:///./fno.db

# --- Upstox OAuth (SSO) ---
# Public hostname must match your Cloudflare Tunnel hostname and the redirect
# URI registered in the Upstox developer console.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=https://trade.example.com/api/auth/upstox/callback
UPSTOX_API_VERSION=2.0
# Upstox API base URLs. Production defaults shown; for sandbox set BOTH to
# https://api-sandbox.upstox.com
UPSTOX_API_BASE=https://api.upstox.com
UPSTOX_ORDER_BASE=https://api-hft.upstox.com
# Set true to use the Upstox sandbox environment (api-sandbox.upstox.com).
# Upstox access token. Empty => user must complete SSO first. (Sandbox: paste the sandbox token.)

# --- UI / serving ---
# Public UI origin (Cloudflare Tunnel hostname) + CORS origin.
FRONTEND_URL=https://trade.example.com
# Internal API base the UI uses for server-side calls.
# Local dev: http://localhost:8000   (docker-compose overrides to http://backend:8000)
BACKEND_URL=http://localhost:8000
# Browser-accessible API base (for the SSO login link the UI renders).
# Dev: http://localhost:8000 | Prod (single origin): same as FRONTEND_URL.
PUBLIC_API_URL=http://localhost:8000
# True when serving over HTTPS (Cloudflare Tunnel terminates TLS).
COOKIE_SECURE=true

# --- Auth / JWT ---
# Master secret used to derive the daily-rotating JWT signing key.
JWT_MASTER_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Single-user SSO allowlist ---
# Your Upstox user_id. Find it after SSO at GET /api/health -> broker.user_id.
# Empty => allow all (dev/test). Production must set this; mismatched SSO
# callbacks and /refresh attempts return HTTP 403 with code "user_not_allowed".
ALLOWED_UPSTOX_USER_ID=

# --- Trading window (24h, IST) ---
TRADING_START=10:00
# Hard cutoff for opening NEW trades. Must be <= SQOFF_TIME. Existing positions
# remain managed by trade_tracker (squared off at SQOFF_TIME).
TRADE_END_TIME=11:00
SQOFF_TIME=14:00

# --- API rate limiting (Flask-Limiter, per client IP) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_STORAGE_URI=memory://

# --- Upstox outbound rate limiting (per-process, inside UpstoxBroker) ---
# Throttle our calls TO Upstox. Order endpoints (place/modify/cancel) are not gated.
UPSTOX_THROTTLING_ENABLED=true
UPSTOX_CANDLES_PER_SECOND=1.0
UPSTOX_LTP_PER_SECOND=10.0
UPSTOX_OPTION_CONTRACTS_PER_SECOND=2.0

# --- Logging ---
LOG_LEVEL=INFO

# --- Instrument auto-seed (Docker entrypoint seeds; S1 retries if empty) ---
AUTO_SEED_INSTRUMENTS=1

# --- LLM breakout detector (OpenRouter, OpenAI-compatible) ---
# OpenRouter is the default provider; the client posts to
# https://openrouter.ai/api/v1/chat/completions with Bearer auth.
LLM_API_KEY=
# Override the provider entirely (any OpenAI-compat base, e.g. plain OpenAI):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Model slug uses OpenRouter's `provider/model` form. Examples:
#   minimax/minimax-m3           (default)
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o
#   google/gemini-pro-1.5
LLM_MODEL=minimax/minimax-m3
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Optional OpenRouter app-attribution headers (recommended for analytics +
# higher rate limits on some routes). Off by default — only sent if set.
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=FnO Trading Bot