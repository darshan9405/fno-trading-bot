FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY scripts ./scripts
COPY deploy ./deploy
COPY run_backend.py .

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

# Single worker (SQLite + in-memory token store + schedulers must share one process);
# threads handle concurrent HTTP requests. Entrypoint seeds instruments first.
CMD ["sh", "/app/deploy/entrypoint.sh"]